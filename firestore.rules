rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(groupId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }
    function role(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role;
    }
    function admin(groupId) {
      return member(groupId) && role(groupId) in ['owner', 'admin'];
    }
    function owner(groupId) {
      return member(groupId) && role(groupId) == 'owner';
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.groupId == ''
        && request.resource.data.role == 'member';
      allow read: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (
        (request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'color'])) ||
        (request.resource.data.groupId is string &&
          existsAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)/members/$(uid)) &&
          request.resource.data.role ==
            getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)/members/$(uid)).data.role) ||
        (resource.data.groupId is string && admin(resource.data.groupId)
          && request.resource.data.groupId == ''
          && request.resource.data.role == 'member'
          && !existsAfter(/databases/$(database)/documents/groups/$(resource.data.groupId)/members/$(uid)))
      );
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /joinCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.groupId is string
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerId == request.auth.uid;
      allow delete: if owner(resource.data.groupId);
      allow update: if false;
    }

    match /groups/{groupId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if member(groupId);
      allow update: if (admin(groupId)
        && request.resource.data.ownerId == resource.data.ownerId)
        || owner(groupId);
      allow delete: if owner(groupId);

      match /requests/{uid} {
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name','color','createdAt']);
        allow read: if admin(groupId) || (signedIn() && request.auth.uid == uid);
        allow delete: if admin(groupId) || (signedIn() && request.auth.uid == uid);
        allow update: if false;
      }

      match /members/{uid} {
        allow read: if member(groupId);
        allow create: if signedIn() && (
          (request.auth.uid == uid &&
            getAfter(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == uid &&
            request.resource.data.role == 'owner') ||
          (admin(groupId) && request.resource.data.role == 'member')
        );
        allow update: if signedIn() && (
          (request.auth.uid == uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','color'])) ||
          (owner(groupId) && uid != request.auth.uid &&
            resource.data.role != 'owner' &&
            request.resource.data.role in ['member','admin'])
        );
        allow delete: if (admin(groupId) && resource.data.role != 'owner')
          || (signedIn() && request.auth.uid == uid && resource.data.role != 'owner')
          || owner(groupId);
      }

      match /lists/{listId} {
        allow read, create, update: if member(groupId);
        allow delete: if member(groupId) &&
          (resource.data.creatorId == request.auth.uid || admin(groupId));
      }

      match /activity/{eventId} {
        allow read: if member(groupId);
        allow create: if member(groupId) && request.resource.data.actorId == request.auth.uid;
        allow update: if false;
        allow delete: if owner(groupId);
      }
    }
  }
}
